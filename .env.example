# Example .env for local development (do not use in production)

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
POSTGRES_DB=gonaj
POSTGRES_USER=gonajuser
POSTGRES_PASSWORD=gonajpass

DB_HOST=db
DB_PORT=5432

# ============================================================================
# DJANGO CORE SETTINGS
# ============================================================================
# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=change-me-locally-and-never-commit-this

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,[::1]

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# Should be different from DJANGO_SECRET_KEY
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(50))'
JWT_SECRET_KEY=change-me-to-different-secret-for-jwt-signing

# Access token lifetime in seconds (default: 900 = 15 minutes)
JWT_ACCESS_TOKEN_LIFETIME=900

# Refresh token lifetime in days (default: 30)
REFRESH_TOKEN_LIFETIME_DAYS=30

# Magic link token max age in seconds (default: 900 = 15 minutes)
MAGIC_LINK_TOKEN_MAX_AGE=900

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
# Development: Uses console backend (prints to terminal)
# Production: Configure SMTP settings below

# For production SMTP (comment out for dev):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-specific-password

# Email addresses
DEFAULT_FROM_EMAIL=noreply@gonaj.com
SERVER_EMAIL=noreply@gonaj.com

# ============================================================================
# FRONTEND URLS
# ============================================================================
# Base URL for magic link redirects
FRONTEND_BASE_URL=http://localhost:3000

# Email confirmation and password reset URLs
FRONTEND_EMAIL_CONFIRM_URL=http://localhost:3000/verify-email/{key}
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password/{key}

# ============================================================================
# SOCIAL AUTHENTICATION (OAuth2)
# ============================================================================
# Google OAuth2
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ============================================================================
# GEODJANGO / GDAL
# ============================================================================
GDAL_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgdal.so

# ============================================================================
# DOCKER USER MAPPING (for development)
# ============================================================================
# Set automatically by set-dev-user.sh
# USER_ID=1000
# GROUP_ID=1000